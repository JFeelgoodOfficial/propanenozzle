{
  // Cloudflare Worker that serves the static site in public/.
  // Workers Builds runs `npx wrangler deploy` on every push to main; "name" must match the Worker in the dashboard.
  "name": "propanenozzle",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
